extends SceneTree
## D05: particle-index builds via particle_preview; clip events align with CHAR07 times.

const VfxCatalog = preload("res://content/vfx/vfx_catalog.gd")
const ParticlePreview = preload("res://content/vfx/particle_preview.gd")
const SkillEvents = preload("res://combat/skill_events_library.gd")
const Timeline = preload("res://combat/skill_timeline.gd")

func _initialize() -> void:
	call_deferred("run")

func run() -> void:
	var fails: PackedStringArray = []
	var assets: Node = root.get_node_or_null("/root/LunexAssets")
	if assets:
		assets.refresh()
	var index := VfxCatalog.load_index()
	if index.is_empty():
		fails.append("particle-index empty")
		_finish(fails)
		return
	print("OK index prefabs=", index.size())
	var source_root := ""
	if assets:
		source_root = String(assets.source_root)
	# Build each class attack + hurt; require at least one CPUParticles3D
	for actor_id in ["10001", "20001", "30001", "40001"]:
		var fx: Node3D = VfxCatalog.build_class_attack(String(actor_id), source_root)
		if fx == null:
			fails.append("build " + String(actor_id))
			continue
		var emitters := ParticlePreview.emitter_count(fx)
		print("OK fx ", actor_id, " emitters=", emitters)
		if emitters < 1:
			fails.append("emitters " + String(actor_id))
		ParticlePreview.dispose(fx)
	var hurt: Node3D = VfxCatalog.build_hurt(source_root)
	if hurt == null:
		fails.append("hurt build")
	else:
		print("OK hurt emitters=", ParticlePreview.emitter_count(hurt))
		ParticlePreview.dispose(hurt)
	# Clip-event sync: timeline fires exactly once at XML time (no early/double)
	for actor_id in ["10001", "20001", "30001", "40001"]:
		var ev: Dictionary = SkillEvents.attack001_event(String(actor_id))
		if ev.is_empty():
			fails.append("event " + String(actor_id))
			continue
		var tl := Timeline.new()
		var got: Array = []
		tl.event_due.connect(func(kind, stamp): got.append({"kind": kind, "t": stamp}))
		tl.start(SkillEvents.attack001_timeline(String(actor_id)))
		var t := float(ev["time"])
		tl.advance(t - 0.001, 1.0)
		if not got.is_empty():
			fails.append("early " + String(actor_id))
		tl.advance(0.002, 1.0)
		if got.size() != 1:
			fails.append("count " + String(actor_id) + "=" + str(got.size()))
		else:
			print("OK sync ", actor_id, " ", got[0]["kind"], "@", got[0]["t"])
		tl.advance(1.0, 1.0)
		if got.size() != 1:
			fails.append("double " + String(actor_id))
	# Unsupported report must exist (generated by tools/dgi/d05_vfx_status.py)
	var report_path := ProjectSettings.globalize_path("res://../docs/darklord/D05_VFX.json")
	if not FileAccess.file_exists(report_path):
		fails.append("D05_VFX.json missing — run tools/dgi/d05_vfx_status.py")
	else:
		var report: Variant = JSON.parse_string(FileAccess.get_file_as_string(report_path))
		if report is Dictionary and int(report.get("prefab_count", 0)) > 0:
			print("OK report unsupported=", report.get("unsupported_count"))
		else:
			fails.append("D05 report bad")
	ParticlePreview.clear_cache()
	_finish(fails)

func _finish(fails: PackedStringArray) -> void:
	if fails.is_empty():
		print("D05_VFX_SYNC_SMOKE_OK")
		quit(0)
		return
	for f in fails:
		print("FAIL ", f)
	print("D05_VFX_SYNC_SMOKE_FAIL")
	quit(1)
