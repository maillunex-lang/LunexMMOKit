FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /lunexd ./cmd/lunexd

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /lunexd /usr/local/bin/lunexd
EXPOSE 18080
ENTRYPOINT ["/usr/local/bin/lunexd","-addr","0.0.0.0:18080"]
