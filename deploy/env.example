# Copy to /etc/lunex/lunex.env (not in git). Never commit real secrets.
LUNEX_LISTEN=127.0.0.1:18080
LUNEX_DATABASE_URL=postgres://lunex:CHANGE_ME@127.0.0.1:5432/lunex?sslmode=disable
LUNEX_DOMAIN=play.example.com
LUNEX_TLS_EMAIL=admin@example.com
LUNEX_BACKUP_DIR=/var/backups/lunex
LUNEX_BACKUP_AGE_DAYS=14
# Optional remote sync (owner must configure credentials separately)
# LUNEX_BACKUP_RCLONE_REMOTE=b2:lunex-backups
